{
    "version": 2,
    "framework": null,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.8.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "env": {
        "APP_NAME": "PP Producoes",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://pproducoes-gestao-operacional-nu.vercel.app",
        "ASSET_URL": "https://pproducoes-gestao-operacional-nu.vercel.app",
        "APP_LOCALE": "pt_BR",
        "APP_FALLBACK_LOCALE": "pt_BR",
        "APP_MAINTENANCE_DRIVER": "array",
        "APP_MAINTENANCE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "LOG_STACK": "stderr",
        "LOG_PATH": "/tmp/logs/laravel.log",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/tmp/database.sqlite",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "SESSION_SAME_SITE": "lax",
        "QUEUE_CONNECTION": "sync",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/views"
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
